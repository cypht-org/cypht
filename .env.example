APP_NAME=Cypht

ENABLE_DEBUG=false
LOG_LEVEL=WARNING
LOG_FILE=

DB_CONNECTION_TYPE=host
DB_DRIVER=mysql
DB_PORT=
DB_HOST=127.0.0.1
DB_NAME=cypht_db
DB_USER=cypht_test
DB_PASS=cypht_test
DB_SOCKET=/var/lib/mysqld/mysqld.sock

# Session storage: PHP, DB, MEM, REDIS or custom. Case insensitive.
# "custom" uses SESSION_CLASS, defaulting to Custom_Session in modules/site/lib.php.
SESSION_TYPE=PHP

# Authentication backend: DB, LDAP, IMAP, dynamic or custom. Case insensitive.
# "custom" uses AUTH_CLASS, defaulting to Custom_Auth in modules/site/lib.php.
# NOTE: there is no "OAUTH" or "SSO" value here. HMAC SSO is a mode of the custom
# class - set AUTH_TYPE=custom and CYPHT_AUTH_TYPE=sso further down.
AUTH_TYPE=DB

IMAP_AUTH_NAME=localhost
IMAP_AUTH_SERVER=localhost
IMAP_AUTH_PORT=143
IMAP_AUTH_TLS=
IMAP_AUTH_SIEVE_CONF_HOST=
IMAP_AUTH_SIEVE_TLS_MODE=true

DEFAULT_SMTP_NAME=
DEFAULT_SMTP_SERVER=
DEFAULT_SMTP_PORT=
DEFAULT_SMTP_TLS=
DEFAULT_SMTP_NO_AUTH=

# User config type: file, db, custom
USER_CONFIG_TYPE=file
USER_SETTINGS_DIR=/var/lib/hm3/users
ATTACHMENT_DIR=/var/lib/hm3/attachments

ADMIN_USERS=

COOKIE_DOMAIN=
COOKIE_PATH=

# SameSite policy for session cookies: Strict, Lax or None. Leave blank for
# Cypht's defaults, which are correct for a standalone install AND for a library
# style embed where the host application boots Cypht in-process and Cypht is
# served from the same site.
#
# Set to None ONLY when Cypht is served from a DIFFERENT site than the page the
# user is looking at - i.e. a cross-origin iframe. The browser treats that as a
# cross-site context and will not send a Strict cookie, so the user logs in and
# is immediately logged out again. None requires HTTPS.
#
# Same-origin embedding (including a same-origin iframe) does NOT need this.
COOKIE_SAMESITE=

DEFAULT_EMAIL_DOMAIN=
AUTO_CREATE_PROFILE=

REDIRECT_AFTER_LOGIN=

ALWAYS_MOBILE_UI=

DEFAULT_LANGUAGE=en

JS_COMPRESS=false
CSS_COMPRESS=false

ALLOW_SESSION_CACHE=false
CACHE_CLASS=

ENABLE_REDIS=true
REDIS_SERVER='127.0.0.1'
REDIS_PORT=6379
REDIS_INDEX=1
REDIS_PASS=
REDIS_SOCKET=/var/run/redis/redis-server.sock

ENABLE_MEMCACHED=true
MEMCACHED_SERVER='127.0.0.1'
MEMCACHED_PORT=11211
MEMCACHED_AUTH=false
MEMCACHED_USER=
MEMCACHED_PASS=

ALLOW_LONG_SESSION=false
LONG_SESSION_LIFETIME=30

ENCRYPT_AJAX_REQUESTS=
ENCRYPT_LOCAL_STORAGE=

ENCRYPT_LOCAL_STORAGE=

DISABLE_IP_CHECK=false

DISABLE_ORIGIN_CHECK=false

ALLOW_EXTERNAL_IMAGE_SOURCES=false

SINGLE_SERVER_MODE=false

# Disable logout entirely. Set this to true when Cypht is embedded in another
# application and login is automatic: it hides the logout button, stops the
# ?page=logout route from ending the session, and disables idle auto-logout.
# The host app ends the session by calling cypht_logout() in its own logout hook.
CYPHT_HIDE_LOGOUT=false

DISABLE_EMPTY_SUPERGLOBALS=false
DISABLE_OPEN_BASE_DIR=false
DISABLE_INI_SETTINGS=false
DISABLE_FINGERPRINT=false

#CUSTOM_AUTH_CLASS= example: Custom_Auth, Custom_Auth_YourApp or empty for default Cypht auth class
AUTH_CLASS=

#CUSTOM_SESSION_CLASS= example: Custom_Session, Custom_Session_YourApp or empty for default Cypht session class
SESSION_CLASS=

API_LOGIN_KEY=

DEFAULT_SETTING_NO_PASSWORD_SAVE=false
DEFAULT_SETTING_IMAP_PER_PAGE=20
DEFAULT_SETTING_SIMPLE_MSG_PARTS=false
DEFAULT_SETTING_PAGINATE_LINKS=true
DEFAULT_SETTING_MSG_PART_ICONS=true
DEFAULT_SETTING_REVIEW_SENT_EMAIL=true
DEFAULT_SETTING_TEXT_ONLY=false
DEFAULT_SETTING_SENT_PER_SOURCE=20
