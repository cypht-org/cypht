{
  "policies": [
    {
      "id": "user-settings-persistence",
      "title": "User settings persistence",
      "description": "Saving settings without permanently persisting them, permanently saving them, and saving them while logging out.",
      "tests": [
        "Hm_Test_Core_Handler_Modules::test_process_save_form"
      ],
      "cases": [
        {
          "id": "session-only-save",
          "description": "A normal settings save does not report permanent persistence.",
          "input": {
            "post": {
              "save_settings": true,
              "password": "foo"
            }
          },
          "expected": {
            "messages": []
          }
        },
        {
          "id": "permanent-save",
          "description": "A permanent settings save reports that settings were saved.",
          "input": {
            "post": {
              "save_settings_permanently": 1,
              "save_settings": true,
              "password": "foo"
            }
          },
          "expected": {
            "messages": ["Settings saved"]
          }
        },
        {
          "id": "permanent-save-and-logout",
          "description": "A permanent settings save followed by logout reports both operations.",
          "input": {
            "post": {
              "save_settings_permanently_then_logout": 1,
              "save_settings": true,
              "password": "foo"
            }
          },
          "expected": {
            "messages": [
              "Saved user data on logout",
              "Session destroyed on logout"
            ]
          }
        }
      ]
    },
    {
      "id": "site-settings-partial-save",
      "title": "Site settings partial saves",
      "description": "A settings save changes only submitted fields, preserving other values in the current session.",
      "tests": [
        "Hm_Test_Core_Functions::test_partial_settings_only_process_submitted_fields"
      ],
      "cases": [
        {
          "id": "preserve-settings-changed-in-another-tab",
          "description": "Saving a different field from a stale tab preserves current numeric and checkbox settings.",
          "input": {
            "current": {"unread_per_source_setting": 42, "show_list_icons_setting": true, "flagged_per_source_setting": 20},
            "post": {"flagged_per_source": 30}
          },
          "expected": {
            "settings": {"unread_per_source_setting": 42, "show_list_icons_setting": true, "flagged_per_source_setting": 30}
          }
        },
        {
          "id": "explicitly-uncheck-setting",
          "description": "An explicitly unchecked checkbox is saved without changing other settings.",
          "input": {
            "current": {"unread_per_source_setting": 42, "show_list_icons_setting": true, "flagged_per_source_setting": 20},
            "post": {"show_list_icons": false}
          },
          "expected": {
            "settings": {"unread_per_source_setting": 42, "show_list_icons_setting": false, "flagged_per_source_setting": 20}
          }
        }
      ]
    },
    {
      "id": "message-external-resource-blocking",
      "title": "Message external-resource blocking",
      "description": "Remote resources in message HTML are not loaded or retained as active resources.",
      "tests": [
        "Hm_Test_Core_Message_Functions::test_sanitize_email_html_blocks_css_tracking"
      ],
      "cases": [
        {
          "id": "block-css-tracking-resource",
          "description": "A remote CSS tracking resource is removed before rendering.",
          "input": {
            "html": "<ul style=\"list-style-image: url(https://tracker.example.com/test)\"><li>x</li></ul>"
          },
          "expected": {
            "blocked_count": 1,
            "must_not_contain": "tracker.example.com"
          }
        },
        {
          "id": "block-background-tracking-resource",
          "description": "A remote background tracking resource is removed before rendering.",
          "input": {
            "html": "<div style=\"background: url(https://tracker.example.com/bg)\">x</div>"
          },
          "expected": {
            "must_not_contain": "tracker.example.com"
          }
        }
      ]
    },
    {
      "id": "http-security-headers",
      "title": "Restrictive HTTP security headers",
      "description": "Secure response headers are emitted by default and external images remain blocked unless explicitly enabled.",
      "tests": [
        "Hm_Test_Core_Handler_Modules::test_http_headers"
      ],
      "cases": [
        {
          "id": "tls-ajax-default-image-policy",
          "description": "TLS AJAX responses include HSTS, JSON content type, and a same-origin image policy.",
          "input": {
            "tls": true,
            "request_type": "AJAX",
            "language": "English",
            "config": {}
          },
          "expected": {
            "headers": {
              "Content-Language": "En",
              "Strict-Transport-Security": "max-age=31536000",
              "X-Frame-Options": "SAMEORIGIN",
              "X-XSS-Protection": "1; mode=block",
              "X-Content-Type-Options": "nosniff",
              "Content-Security-Policy": "default-src 'none'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self';",
              "Content-Type": "application/json"
            }
          }
        },
        {
          "id": "explicit-external-image-policy",
          "description": "External image sources are allowed only when the administrator enables the setting.",
          "input": {
            "tls": true,
            "request_type": "AJAX",
            "language": "English",
            "config": {
              "allow_external_image_sources": true
            }
          },
          "expected": {
            "headers": {
              "Content-Security-Policy": "default-src 'none'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; img-src * data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self';"
            }
          }
        }
      ]
    },
    {
      "id": "brute-force-protection",
      "title": "Brute-force protection",
      "description": "Failed-login tracking uses non-reversible identifiers and locks an identifier after the configured threshold.",
      "tests": [
        "Hm_Test_Brute_Force_Handler_Modules::test_make_key_returns_consistent_hash"
      ],
      "cases": [
        {
          "id": "hash-login-attempt-identifier",
          "description": "The tracker namespaces and hashes identifiers instead of storing the raw value.",
          "input": {
            "prefix": "ip",
            "value": "127.0.0.1",
            "different_value": "10.0.0.1"
          },
          "expected": {
            "same_value_same_key": true,
            "different_value_different_key": true,
            "key_must_not_contain": "127.0.0.1"
          }
        }
      ]
    },
    {
      "id": "second-factor-gates-password-only-session",
      "title": "Second factor gates a password-only session",
      "description": "A session that has not confirmed TOTP cannot run later account changes or receive an authenticated AJAX payload.",
      "tests": [
        "Hm_Test_2fa_Handler_Modules::test_password_only_session_is_gated"
      ],
      "cases": [
        {
          "id": "unconfirmed-session-skips-later-handlers",
          "description": "A password-only session does not run a later write handler, still saves session user data, and closes the session.",
          "input": {
            "request_type": "HTTP",
            "two_factor_confirmed": false,
            "logout": false
          },
          "expected": {
            "halted": true,
            "password_changed": false,
            "user_data_saved": true,
            "session_closed": true,
            "handler_halt_in_response": false
          }
        },
        {
          "id": "confirmed-session-runs-later-handlers",
          "description": "A session that has confirmed TOTP runs later handlers and leaves the session open.",
          "input": {
            "request_type": "HTTP",
            "two_factor_confirmed": true,
            "logout": false
          },
          "expected": {
            "halted": false,
            "password_changed": true,
            "session_closed": false,
            "handler_halt_in_response": false
          }
        },
        {
          "id": "unconfirmed-ajax-returns-status-only",
          "description": "An AJAX request on a password-only session returns the second-factor status and no authenticated payload.",
          "input": {
            "request_type": "AJAX",
            "two_factor_confirmed": false,
            "logout": false
          },
          "expected": {
            "halted": true,
            "password_changed": false,
            "ajax_status": "2fa required",
            "folder_list_present": false,
            "handler_halt_in_response": false
          }
        },
        {
          "id": "logout-destroys-before-session-close",
          "description": "Logout on a gated session destroys the session before the executor closes it.",
          "input": {
            "request_type": "HTTP",
            "two_factor_confirmed": false,
            "logout": true
          },
          "expected": {
            "destroy_before_close": true,
            "password_changed": false
          }
        }
      ]
    },
    {
      "id": "second-factor-attempt-lockout",
      "title": "Second factor locks after repeated failures",
      "description": "Wrong login codes are counted per account. Enough failures lock the second factor. A later password login shows the lock message instead of the code form, until a correct code clears the counter.",
      "tests": [
        "Hm_Test_2fa_Handler_Modules::test_second_factor_attempt_lockout"
      ],
      "cases": [
        {
          "id": "wrong-code-is-counted",
          "description": "A wrong 6-digit login code is stored against the account and does not confirm the session.",
          "input": {
            "username": "alice",
            "code": "000000",
            "valid": false,
            "seed_count": 0,
            "seed_locked_for": 0
          },
          "expected": {
            "confirmed": false,
            "session_destroyed": false,
            "locked": false,
            "attempt_count": 1,
            "error": "does not match"
          }
        },
        {
          "id": "fifth-failure-locks-and-ends-session",
          "description": "The 6-digit failure that reaches the limit locks the account and ends the password session.",
          "input": {
            "username": "alice",
            "code": "000000",
            "valid": false,
            "seed_count": 4,
            "seed_locked_for": 0
          },
          "expected": {
            "confirmed": false,
            "session_destroyed": true,
            "locked": true,
            "attempt_count": 5,
            "error": "",
            "notice": "ERR: Too many"
          }
        },
        {
          "id": "locked-login-shows-the-lock-message",
          "description": "A later password login reads the active lock and shows the lock message instead of the code form.",
          "input": {
            "username": "alice",
            "submit_code": false,
            "seed_count": 5,
            "seed_locked_for": 900
          },
          "expected": {
            "confirmed": false,
            "session_destroyed": true,
            "locked": true,
            "attempt_count": 5,
            "error": "",
            "notice": "ERR: Too many",
            "code_form": false
          }
        },
        {
          "id": "locked-account-rejects-a-valid-code",
          "description": "A new password session cannot submit the current 6-digit authenticator code while the account lock is active.",
          "input": {
            "username": "alice",
            "valid": true,
            "seed_count": 5,
            "seed_locked_for": 900
          },
          "expected": {
            "confirmed": false,
            "session_destroyed": true,
            "locked": true,
            "attempt_count": 5,
            "error": "",
            "notice": "ERR: Too many"
          }
        },
        {
          "id": "valid-code-clears-the-counter",
          "description": "The current 6-digit authenticator code confirms the session and removes the failure counter.",
          "input": {
            "username": "alice",
            "valid": true,
            "seed_count": 2,
            "seed_locked_for": 0
          },
          "expected": {
            "confirmed": true,
            "session_destroyed": false,
            "locked": false,
            "attempt_count": null,
            "error": ""
          }
        }
      ]
    },
    {
      "id": "user-added-server-hosts",
      "title": "User-added server host policy",
      "description": "User-added mail servers share the core host helper with feeds. Public hosts are allowed. Internal hosts follow ALLOW_INTERNAL_SERVERS. Link-local addresses, including cloud metadata, are always denied. Alternate IP spellings are judged as the address they dial.",
      "tests": [
        "Hm_Test_Core_Server_Target::test_user_added_server_host_policy"
      ],
      "cases": [
        {
          "id": "public-ipv4-allowed",
          "description": "A public IPv4 address can be added with the default flags.",
          "input": {"host": "8.8.8.8", "flags": {}},
          "expected": {"allowed": true, "class": "public", "canonical": "8.8.8.8"}
        },
        {
          "id": "private-ipv4-allowed-when-enabled",
          "description": "An RFC1918 address can be added when internal servers are allowed.",
          "input": {"host": "10.1.1.1", "flags": {"allow_internal_servers": true}},
          "expected": {"allowed": true, "class": "internal", "canonical": "10.1.1.1"}
        },
        {
          "id": "private-ipv4-blocked-by-default",
          "description": "An RFC1918 address is rejected when internal servers are disabled.",
          "input": {"host": "192.168.1.1", "flags": {}},
          "expected": {"allowed": false, "class": "internal", "canonical": "192.168.1.1"}
        },
        {
          "id": "link-local-always-blocked",
          "description": "A link-local address, including a cloud metadata address, is always rejected.",
          "input": {"host": "169.254.169.254", "flags": {}},
          "expected": {"allowed": false, "class": "link_local", "canonical": "169.254.169.254"}
        },
        {
          "id": "link-local-blocked-when-internal-allowed",
          "description": "Link-local stays denied even when internal servers are allowed.",
          "input": {"host": "169.254.1.1", "flags": {"allow_internal_servers": true}},
          "expected": {"allowed": false, "class": "link_local", "canonical": "169.254.1.1"}
        },
        {
          "id": "loopback-allowed-when-enabled",
          "description": "A loopback address can be added when internal servers are allowed.",
          "input": {"host": "127.0.0.1", "flags": {"allow_internal_servers": true}},
          "expected": {"allowed": true, "class": "internal", "canonical": "127.0.0.1"}
        },
        {
          "id": "localhost-name-is-internal",
          "description": "The hostname localhost follows the internal-server setting.",
          "input": {"host": "localhost", "flags": {"allow_internal_servers": true}},
          "expected": {"allowed": true, "canonical": "localhost"}
        },
        {
          "id": "loopback-blocked-by-default",
          "description": "IPv6 loopback is rejected when internal servers are disabled.",
          "input": {"host": "::1", "flags": {}},
          "expected": {"allowed": false, "class": "internal", "canonical": "::1"}
        },
        {
          "id": "mapped-loopback-follows-internal-flag",
          "description": "An IPv4-mapped loopback address is judged as internal under the internal-server flag.",
          "input": {"host": "::ffff:127.0.0.1", "flags": {}},
          "expected": {"allowed": false, "class": "internal", "canonical": "127.0.0.1"}
        },
        {
          "id": "mapped-public-unwrapped",
          "description": "An IPv4-mapped public address is allowed as that public address.",
          "input": {"host": "::ffff:8.8.8.8", "flags": {}},
          "expected": {"allowed": true, "class": "public", "canonical": "8.8.8.8"}
        },
        {
          "id": "decimal-loopback",
          "description": "A 32-bit decimal address is judged as the dotted address it dials.",
          "input": {"host": "2130706433", "flags": {"allow_internal_servers": true}},
          "expected": {"allowed": true, "class": "internal", "canonical": "127.0.0.1"}
        },
        {
          "id": "short-loopback",
          "description": "A short IPv4 form is judged as the dotted address it dials.",
          "input": {"host": "127.1", "flags": {"allow_internal_servers": true}},
          "expected": {"allowed": true, "class": "internal", "canonical": "127.0.0.1"}
        },
        {
          "id": "short-private",
          "description": "A two-part private address expands before the internal-server flag is applied.",
          "input": {"host": "10.1", "flags": {}},
          "expected": {"allowed": false, "class": "internal", "canonical": "10.0.0.1"}
        },
        {
          "id": "octal-loopback",
          "description": "An octal IPv4 spelling is judged as the dotted address it dials.",
          "input": {"host": "0177.0.0.1", "flags": {"allow_internal_servers": true}},
          "expected": {"allowed": true, "class": "internal", "canonical": "127.0.0.1"}
        },
        {
          "id": "hex-loopback",
          "description": "A hex IPv4 spelling is judged as the dotted address it dials.",
          "input": {"host": "0x7f.0.0.1", "flags": {"allow_internal_servers": true}},
          "expected": {"allowed": true, "class": "internal", "canonical": "127.0.0.1"}
        },
        {
          "id": "transport-prefix-rejected",
          "description": "A unix socket transport is not a mail server host.",
          "input": {"host": "unix:///tmp/mail.sock", "flags": {}},
          "expected": {"allowed": false, "canonical": false}
        },
        {
          "id": "tls-prefix-rejected",
          "description": "A tls transport prefix is not accepted as a hostname.",
          "input": {"host": "tls://127.0.0.1", "flags": {}},
          "expected": {"allowed": false, "canonical": false}
        },
        {
          "id": "unspecified-address-is-internal",
          "description": "The unspecified IPv4 address follows the internal-server flag.",
          "input": {"host": "0.0.0.0", "flags": {"allow_internal_servers": true}},
          "expected": {"allowed": true, "class": "internal", "canonical": "0.0.0.0"}
        },
        {
          "id": "multicast-is-public-under-php-flags",
          "description": "A multicast address is treated as public by PHP filter flags.",
          "input": {"host": "224.0.0.1", "flags": {}},
          "expected": {"allowed": true, "class": "public", "canonical": "224.0.0.1"}
        },
        {
          "id": "shared-address-space-allowed",
          "description": "Shared address space is not treated as link-local or internal.",
          "input": {"host": "100.64.0.1", "flags": {}},
          "expected": {"allowed": true, "class": "public", "canonical": "100.64.0.1"}
        },
        {
          "id": "jmap-file-url-rejected",
          "description": "A JMAP URL must be http or https.",
          "input": {"url": "file://localhost/etc/passwd", "flags": {}},
          "expected": {"allowed": false}
        },
        {
          "id": "jmap-link-local-url-rejected",
          "description": "A JMAP URL on a link-local host is always rejected.",
          "input": {"url": "http://169.254.169.254/latest/meta-data/", "flags": {}},
          "expected": {"allowed": false}
        },
        {
          "id": "jmap-public-url-allowed",
          "description": "A JMAP URL on a public host is allowed.",
          "input": {"url": "https://8.8.8.8/jmap", "flags": {}},
          "expected": {"allowed": true}
        },
        {
          "id": "saved-link-local-is-not-dialed",
          "description": "Opening a saved mailbox does not dial a link-local host.",
          "input": {"host": "169.254.169.254", "port": 80},
          "expected": {"connect_calls": 0}
        }
      ]
    }
  ]
}
