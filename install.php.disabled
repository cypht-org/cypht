<?php

/**
 * One-time web installer. Disabled by default: rename this file to
 * install.php to activate it. It refuses to run once .env exists, and it
 * never duplicates Hm_Installer's or Hm_Web_Installer's logic, only calls
 * them.
 *
 * Access is gated by a one-time token written to .install_token next to this
 * file. The leading dot matters: the project's .htaccess denies HTTP access
 * to dotfiles, so the token is only reachable over FTP/SSH/file manager, not
 * by requesting it as a URL. Retrieve it that way and pass it as ?token=...
 * before any form is shown, so a bystander who finds this URL while it's
 * enabled still cannot use it. This protection needs Apache (or another
 * server honoring .htaccess) with AllowOverride enabled, which is the norm
 * on the shared hosting this installer targets; on Nginx or other servers,
 * use scripts/install.php instead.
 */

error_reporting(E_ALL);
ini_set('display_errors', '0');

define('APP_PATH', __DIR__.'/');
require APP_PATH.'lib/installer.php';
require APP_PATH.'lib/web_installer.php';

header('X-Content-Type-Options: nosniff');
header('Cache-Control: no-store');

$installer = new Hm_Installer();

if ($installer->envExists()) {
    render_page('Already installed', '<p>Cypht is already configured. Delete .env first if you really want to run the installer again.</p>');
    exit;
}

$web_installer = new Hm_Web_Installer($installer, APP_PATH.'.install_token');

session_set_cookie_params(['httponly' => true, 'samesite' => 'Lax', 'secure' => Hm_Web_Installer::isHttps($_SERVER)]);
session_start();

if (!$web_installer->tokenExists()) {
    $web_installer->generateToken();
    render_page('Installer locked', '<p>A one-time access token was generated. Retrieve it from <code>.install_token</code> next to this script (over FTP, SSH, or your host\'s file manager; enable "show hidden files" if needed), then reopen this page with <code>?token=</code> appended.</p>');
    exit;
}

$given_token = $_GET['token'] ?? ($_POST['token'] ?? '');
if (!$web_installer->tokenMatches($given_token)) {
    render_page('Installer locked', '<p>Missing or invalid token.</p>');
    exit;
}

// A valid token proves filesystem access, promoting this session from
// anonymous to installer-operator: regenerate the id so a session fixed
// before that point (e.g. via a cookie set on a shared subdomain) can't
// be reused to submit the form on the operator's behalf.
if (empty($_SESSION['token_verified'])) {
    session_regenerate_id(true);
    $_SESSION['token_verified'] = true;
}

$missing = array_keys(array_filter($installer->checkRequirements(), fn($ok) => !$ok));
if (!empty($missing)) {
    render_page('Missing requirements', '<p>The server is missing: '.htmlspecialchars(implode(', ', $missing)).'</p>');
    exit;
}

if (empty($_SESSION['csrf_token'])) {
    $_SESSION['csrf_token'] = bin2hex(random_bytes(24));
}
$csrf_token = $_SESSION['csrf_token'];

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!Hm_Web_Installer::secretMatches($csrf_token, $_POST['csrf_token'] ?? '')) {
        render_page('Installer locked', '<p>Invalid session, reload the form and try again.</p>');
        exit;
    }

    try {
        $values = Hm_Web_Installer::collectFormValues($_POST);
        $result = $web_installer->install($values, $_POST['admin_user'] ?? '', $_POST['admin_pass'] ?? '');
        $body = '<pre>'.htmlspecialchars($result['output']).'</pre>';

        if ($result['success']) {
            $web_installer->consumeToken();
            render_page('Installation complete', $body.'<p><strong>Delete or rename install.php now.</strong></p>');
        }
        else {
            render_page('Installation failed', $body.'<p>The .env file may have been written before this step failed. If you retry, delete .env first or the installer will report itself as already configured.</p>');
        }
    }
    catch (Throwable $e) {
        error_log('Cypht installer error: '.$e->getMessage());
        render_page('Installation failed', '<p>An unexpected error occurred. Check the server error log.</p>');
    }
    exit;
}

render_form($csrf_token, $given_token);

function render_form($csrf_token, $token) {
    $fields = [
        'DB_DRIVER' => 'Database driver (mysql, pgsql, sqlite)',
        'DB_HOST' => 'Database host',
        'DB_NAME' => 'Database name',
        'DB_USER' => 'Database user',
        'DB_PASS' => 'Database password',
        'USER_SETTINGS_DIR' => 'User settings directory (outside the web root)',
        'ATTACHMENT_DIR' => 'Attachment directory (outside the web root)',
    ];
    $rows = '';
    foreach ($fields as $name => $label) {
        $type = str_contains($name, 'PASS') ? 'password' : 'text';
        $rows .= '<p><label>'.htmlspecialchars($label).'<br><input type="'.$type.'" name="'.htmlspecialchars($name).'"></label></p>';
    }
    $rows .= '<p><label>Admin username (optional)<br><input type="text" name="admin_user"></label></p>';
    $rows .= '<p><label>Admin password<br><input type="password" name="admin_pass"></label></p>';

    $body = '<form method="post">'.
        '<input type="hidden" name="csrf_token" value="'.htmlspecialchars($csrf_token).'">'.
        '<input type="hidden" name="token" value="'.htmlspecialchars($token).'">'.
        $rows.
        '<p><button type="submit">Install</button></p>'.
        '</form>';
    render_page('Cypht installer', $body);
}

function render_page($title, $body) {
    echo '<!DOCTYPE html><html><head><meta charset="utf-8"><title>'.htmlspecialchars($title).'</title></head>'.
        '<body>'.'<h1>'.htmlspecialchars($title).'</h1>'.$body.'</body></html>';
}
